{
  "manifest_version": 3,
  "name": "Veyra — Browser Workspace",
  "short_name": "Veyra",
  "version": "0.1.4",
  "description": "A calm, bilingual browser workspace for tabs, bookmarks, AI conversations and local decisions.",
  "permissions": [
    "tabs",
    "bookmarks",
    "storage",
    "alarms",
    "scripting",
    "contextMenus",
    "tabGroups"
  ],
  "optional_permissions": [
    "history",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/ui/newtab.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Veyra",
    "default_popup": "src/ui/popup.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "minimum_chrome_version": "116"
}
